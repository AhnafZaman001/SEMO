# OS junk
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/
*.swp

# Local env files -- this project embeds its Supabase URL/anon key
# directly in js/supabase-client.js (the anon key is meant to be
# public, same pattern as Future-Pathways/AXIOM), but .env is
# ignored anyway in case one gets added later for anything else.
.env
.env.local
.env*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cloudflare Pages
.wrangler/

# Misc build artifacts (none expected -- this is a static site with
# no build step -- but harmless to ignore if any tooling adds one later)
/dist
/build
